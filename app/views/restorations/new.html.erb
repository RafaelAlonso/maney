<%# app/views/restorations/new.html.erb — the only screen a deleted account reaches. %>
<h1 class="text-lg font-semibold mb-4">Sua conta está excluída</h1>

<p class="text-sm text-gray-700 mb-4">
  Tudo o que é seu será apagado em definitivo em
  <strong><%= pluralize(Current.user.days_until_erasure, "dia", "dias") %></strong>.
  Até lá, você pode restaurar sua conta exatamente como estava.
</p>

<%= button_to "restaurar minha conta", restoration_path,
      class: "bg-blue-600 text-white rounded px-4 py-2" %>

<%= button_to "sair", session_path, method: :delete,
      class: "bg-gray-700 text-white rounded px-4 py-2 mt-3" %>

<%# locals: chart (an Analysis::ProfitChart)
    Unlike the other cards, this one mounts its Stimulus controller on the card
    element itself — the mode buttons and the canvas are both inside its scope —
    so it passes the data attributes through to shared/card. %>
<% heading_id = "#{chart.class.name.demodulize.underscore}-title" %>
<%= render layout: "shared/card",
           locals: { title: chart.title, heading_id:, note: chart.note,
                     attributes: { data: { controller: "profit-chart",
                                           profit_chart_config_value: chart.to_config.to_json,
                                           profit_chart_modes_value: chart.modes.to_json } } } do %>
  <div class="flex gap-2 mb-3 overflow-x-auto whitespace-nowrap">
    <% chart.mode_labels.each do |key, label| %>
      <button type="button"
              class="shrink-0 border border-border text-text rounded px-3 py-1 text-xs aria-pressed:bg-accent aria-pressed:text-white"
              aria-pressed="<%= key == Analysis::ProfitChart::DEFAULT_MODE %>"
              data-profit-chart-target="mode"
              data-action="profit-chart#select"
              data-profit-chart-mode-param="<%= key %>"><%= label %></button>
    <% end %>
  </div>
  <div class="h-64"><canvas aria-labelledby="<%= heading_id %>"></canvas></div>
<% end %>

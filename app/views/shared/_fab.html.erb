<div data-controller="fab" class="fixed bottom-6 right-6 z-10 flex flex-col items-end gap-2">
  <div data-fab-target="menu" hidden class="flex flex-col items-end gap-2">
    <%# The month on screen travels into the form (see ApplicationController#default_entry_date). %>
    <%= render "shared/button", label: "ganho", href: new_income_path(month: month_param), variant: :positive, class: "shadow" %>
    <%= render "shared/button", label: "gasto", href: new_expense_path(month: month_param), variant: :danger, class: "shadow" %>
  </div>
  <button type="button" data-action="fab#toggle" aria-label="Lançar"
          class="btn-primary rounded-full w-14 h-14 text-2xl shadow-lg">+</button>
</div>

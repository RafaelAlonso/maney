<h1 class="text-lg font-semibold mb-2">Gastos</h1>
<%= render "shared/month_nav", path_helper: ->(month:) { expenses_path(month:) } %>
<ul class="divide-y divide-border rounded border border-border bg-surface">
  <%= render partial: "row", collection: @expenses, as: :expense,
        locals: { show_delete: true, statements: @statements } %>
  <% if @expenses.empty? %><%= render "shared/empty_state", message: "Nenhum gasto neste mês." %><% end %>
</ul>

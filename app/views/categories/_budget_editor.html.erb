<%# app/views/categories/_budget_editor.html.erb — locals: category, summary;
    optional: error. The budget editor lives HERE, on the category's own
    dashboard — not on the Início card, which is now read-only. Same click-to-edit
    pattern the month view used to carry: the display span toggles to an inline
    form (budget-edit controller) that upserts through BudgetsController, which
    streams this same partial back in place.

    The reserved credit-card category shows no form: its orçado is derived from the
    statements (Budget#not_on_credit_card_category rejects a manual one), so there
    is nothing to edit. Wrapped in dom_id(category, :budget) so the stream finds it. %>
<div id="<%= dom_id(category, :budget) %>" class="card" data-controller="budget-edit">
  <% if category.credit_card? %>
    <p class="text-sm text-muted">O orçado do cartão de crédito é derivado das faturas e não pode ser editado.</p>
  <% else %>
    <% spent = summary.spent_cents(category) %>
    <% budgeted = summary.budgeted_cents(category) %>
    <% over = budgeted.positive? && spent > budgeted %>
    <% error = local_assigns[:error] %>
    <% open = error.present? %>
    <div class="flex items-center justify-between gap-2 text-sm">
      <span class="<%= over ? "text-money-over font-medium" : "text-muted" %>">gasto <%= brl(spent) %></span>
      <div class="text-right shrink-0">
        <span data-budget-edit-target="display" data-action="click->budget-edit#edit"
              class="cursor-pointer <%= "hidden" if open %> <%= over ? "text-money-over font-medium" : "text-muted" %>">
          orçado <%= brl(budgeted) %> <span class="text-accent text-xs">· editar</span>
        </span>
        <%= form_with url: budgets_path, method: :post, class: open ? "inline" : "hidden",
              data: { budget_edit_target: "form" } do |f| %>
          <%= f.hidden_field :category_id, value: category.id %>
          <%= f.hidden_field :month, value: summary.month.strftime("%Y-%m") %>
          <%= f.text_field :budget_amount, value: BrlMoney.format(budgeted), inputmode: "decimal",
                class: "field-input w-28 text-sm inline", data: { budget_edit_target: "input" } %>
        <% end %>
        <% if error %><span class="field-error"><%= error %></span><% end %>
      </div>
    </div>
    <div class="mt-2"><%= render "shared/budget_bar", spent_cents: spent, budgeted_cents: budgeted %></div>
  <% end %>
</div>

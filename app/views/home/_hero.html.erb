<%# app/views/home/_hero.html.erb — locals: summary
    The balance hero: saldo estimado is the primary figure; saldo atual and the
    income total are supporting stats. "saldo atual" is also a toggle: tapped,
    it unfolds what it is made of — the accounts and the month's card bills
    (home/_hero_breakdown). Folded by default everywhere, so the pinned header
    stays short on a phone. The income breakdown that used to sit below lives on
    Ganhos now — only the total is here, linking there. %>
<div id="hero" class="card" data-controller="disclosure">
  <p class="text-sm text-muted mb-1">saldo estimado</p>
  <p class="text-3xl font-semibold tabular-nums <%= "text-money-over" if summary.estimated_balance_cents.negative? %>">
    <%= brl(summary.estimated_balance_cents) %>
  </p>
  <div class="mt-4 flex items-center gap-6 text-sm">
    <button type="button" class="text-left" aria-expanded="false" aria-controls="hero-breakdown"
            data-disclosure-target="button" data-action="disclosure#toggle">
      <span class="block text-muted">saldo atual <span aria-hidden="true">▾</span></span>
      <span class="tabular-nums <%= "text-money-over" if summary.current_balance_cents.negative? %>">
        <%= brl(summary.current_balance_cents) %>
      </span>
    </button>
    <%= link_to incomes_path(month: summary.month.strftime("%Y-%m")), class: "text-accent" do %>
      <span class="block text-muted">ganhos</span>
      <span class="tabular-nums <%= "text-money-over" if summary.incomes_total_cents.negative? %>">
        <%= brl(summary.incomes_total_cents) %> ›
      </span>
    <% end %>
  </div>
  <%= render "home/hero_breakdown", summary: %>
</div>

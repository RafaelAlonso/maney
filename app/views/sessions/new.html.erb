<%# app/views/sessions/new.html.erb %>
<h1 class="text-lg font-semibold mb-4 text-text">Entrar</h1>

<%= form_with url: session_path, class: "space-y-4" do |f| %>
  <div>
    <%= f.label :email_address, "E-mail", class: "field-label" %>
    <%= f.email_field :email_address, required: true, autofocus: true, autocomplete: "username",
          value: params[:email_address], class: "field-input" %>
  </div>
  <div>
    <%= f.label :password, "Senha", class: "field-label" %>
    <%= f.password_field :password, required: true, autocomplete: "current-password",
          maxlength: 72, class: "field-input" %>
  </div>
  <%= f.submit "entrar", class: "btn btn-primary" %>
<% end %>

<p class="mt-4">
  <%= link_to "esqueci minha senha", new_password_path, class: "text-accent text-sm" %>
</p>

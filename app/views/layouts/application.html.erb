<!DOCTYPE html>
<html lang="pt-BR"<%= " class=\"#{theme_html_class}\"".html_safe unless theme_html_class.blank? %>>
  <head>
    <title><%= content_for(:title) || "Maney" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="application-name" content="Maney">
    <%# Without this, Add to Home Screen on iOS names the app after <title>, so
        installing from Análise would call it "Análise". Android reads
        short_name from the manifest and needs no equivalent. %>
    <meta name="apple-mobile-web-app-title" content="Maney">
    <meta name="mobile-web-app-capable" content="yes">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= yield :head %>

    <%= tag.link rel: "manifest", href: pwa_manifest_path(format: :json) %>
    <meta name="theme-color" content="#f8fafc" media="(prefers-color-scheme: light)">
    <meta name="theme-color" content="#0b0f14" media="(prefers-color-scheme: dark)">
    <%# Offline, a restored snapshot would present old totals as current — the one
        failure this app cannot afford. Without a snapshot, a back-navigation makes
        a real request, which fails and lands on the no-connection screen. %>
    <meta name="turbo-cache-control" content="no-cache">
    <%# Prefetching keeps a fetched page in memory and hands it to a later visit
        without a request leaving the browser, so neither the service worker nor
        the tag above ever sees it. Offline that means figures up to ten seconds
        old presented as current — the same failure by another route. %>
    <meta name="turbo-prefetch" content="false">

    <link rel="icon" href="/icon.png" type="image/png">
    <link rel="icon" href="/icon.svg" type="image/svg+xml">
    <link rel="apple-touch-icon" href="/apple-touch-icon.png">

    <%= stylesheet_link_tag "tailwind", "data-turbo-track": "reload" %>

    <%# Includes all stylesheet files in app/assets/stylesheets %>
    <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>
    <%# The import map pins scoped package names ("@hotwired/turbo-rails", ...),
        so it puts a literal "@" in every response that includes it. The
        invalid-link screen (SignupsController) must reveal nothing about whose
        invitation it was, so it sets @omit_importmap_tags to keep that "@" out
        of its body — everything else here still applies to it. %>
    <%= javascript_importmap_tags unless @omit_importmap_tags %>
  </head>

  <% chrome = authenticated? && Setting.instance && !Current.user.deleted? %>
  <body class="min-h-screen bg-bg text-text">
    <%# A deleted-but-restorable person is held on the restore screen, so the nav
        would be dead weight — the gate below hides it (unchanged). %>
    <% if chrome %>
      <%= render "shared/desktop_nav" %>
      <div class="md:hidden" data-controller="mais-panel">
        <%= render "shared/mobile_top_bar" %>
        <%= render "shared/mais_panel" %>
      </div>
      <%= render "shared/mobile_bottom_bar" %>
    <% else %>
      <%= render "shared/auth_header" %>
    <% end %>
    <div class="<%= class_names("pt-16 pb-24 md:pt-6 md:pb-6" => chrome) %>">
      <%= render "shared/flash", notice:, alert: %>
      <main class="p-4 max-w-xl mx-auto"><%= yield %></main>
    </div>
    <%= render "shared/fab" if chrome %>
  </body>
</html>

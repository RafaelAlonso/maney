<%# app/views/home/show.html.erb
    The month dashboard. The balance hero (and, where there is spending, the
    category bar chart) stay pinned at the top while the category list scrolls
    beneath them — a sticky header over a page-scrolled list, so "Saldo Estimado"
    is never lost behind a long list on either mobile or desktop.

    On desktop the hero and chart sit side by side, using the width the screen
    has; on mobile they become a horizontal snap carousel, one card at a time.

    The whole screen is one `percent` controller so the switch in the controls bar
    can toggle the per-card percentage spans without a server round-trip. %>
<%= render "shared/month_nav", path_helper: ->(month:) { root_path(month:) } %>

<div data-controller="percent" data-percent-mode-value="<%= @percent_mode %>">
  <div class="sticky top-16 z-10 bg-bg">
    <div class="flex md:grid md:grid-cols-2 gap-4 overflow-x-auto snap-x snap-mandatory
                md:overflow-visible -mx-4 px-4 md:mx-0 md:px-0">
      <div class="snap-center shrink-0 w-full md:w-auto">
        <%= render "home/hero", summary: @summary %>
      </div>
      <% if @category_chart.any? %>
        <div class="snap-center shrink-0 w-full md:w-auto">
          <%= render "home/category_chart", chart: @category_chart %>
        </div>
      <% end %>
    </div>

    <%= render "home/alert", alert: @alert %>
    <%= render "home/controls", summary: @summary, sort: @sort, direction: @direction, percent_mode: @percent_mode %>
  </div>

  <div class="card divide-y divide-border !p-0 overflow-hidden">
    <% @categories.each do |category| %>
      <%= render "home/category_row", category:, summary: @summary,
            percent_mode: @percent_mode, expenses_total_cents: @expenses_total_cents %>
    <% end %>
  </div>
</div>

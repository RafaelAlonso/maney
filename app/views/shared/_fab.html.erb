<%# app/views/shared/_fab.html.erb — desktop floating "+" (bottom-right).
    Mobile uses the bottom-bar center "+" (shared/_mobile_bottom_bar). %>
<div data-controller="fab" class="hidden md:flex fixed bottom-6 right-6 z-10 flex-col items-end gap-2">
  <div data-fab-target="menu" hidden class="flex flex-col items-end gap-2">
    <%= render "shared/entry_buttons" %>
  </div>
  <button type="button" data-action="fab#toggle" aria-label="Lançar"
          class="btn-primary rounded-full w-14 h-14 text-2xl shadow-lg">+</button>
</div>

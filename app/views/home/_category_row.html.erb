<%# app/views/home/_category_row.html.erb — locals: category, summary; optional: error
    A two-branch delegator. The wrapper element lives INSIDE each branch,
    because the two rows are now different elements: the card row is a
    <details>, an ordinary row a <div data-controller="budget-edit">.

    This partial stays the single entry point — home/show must not choose
    between the two. budgets/create.turbo_stream.erb re-renders THIS partial for
    whatever category was posted, and posting a budget against the credit-card
    category is reachable (Budget#not_on_credit_card_category rejects it with a
    422), so this branch must not blow up or render a budget form for a
    category that cannot have one. The card row deliberately renders no error —
    it has no budget form to correct, so there's nowhere on the row to show one. %>
<% if category.credit_card? %>
  <%= render "home/credit_card_row", category:, summary: %>
<% else %>
  <% spent = summary.spent_cents(category) %>
  <% budgeted = summary.budgeted_cents(category) %>
  <%# An unbudgeted category (budgeted 0) is not an overrun — it's a category the
      user hasn't got to yet. Painting it red drowns out the real overruns
      precisely in the months where they matter most: the first one, and any month
      with a new category (w3 AC3 asks the line to highlight THE overrun). %>
  <% over = budgeted.positive? && spent > budgeted %>
  <% error = local_assigns[:error] %>
  <% open = error.present? %>
  <div id="<%= dom_id(category, :row) %>" class="p-3" data-controller="budget-edit">
    <div class="flex items-center justify-between gap-2">
      <%= link_to category.name, category_path(category, month: summary.month.strftime("%Y-%m")),
            class: "text-text hover:underline truncate" %>
      <%# Each segment is whitespace-nowrap so the line can only ever break at the
          single space between them — never inside an amount — giving the fixed
          "gasto [amount] /" ⏎ "orçado [amount]" split when it has to wrap. %>
      <div class="text-sm text-right shrink-0">
        <span class="whitespace-nowrap <%= over ? "text-money-over font-medium" : "text-muted" %>">
          gasto <%= brl(spent) %> /
        </span>
        <%# Visibility is carried by Tailwind's `hidden` class, not the `hidden`
            attribute: `form_with` drops a top-level `hidden:` option, and the
            form's `inline` display beats `[hidden] { display: none }` on
            specificity. The Stimulus controller toggles the same class. %>
        <span data-budget-edit-target="display" data-action="click->budget-edit#edit"
              class="whitespace-nowrap cursor-pointer <%= open ? "hidden" : "" %> <%= over ? "text-money-over font-medium" : "text-muted" %>">
          orçado <%= brl(budgeted) %>
        </span>
        <%= form_with url: budgets_path, method: :post, class: open ? "inline" : "hidden",
              data: { budget_edit_target: "form" } do |f| %>
          <%= f.hidden_field :category_id, value: category.id %>
          <%= f.hidden_field :month, value: summary.month.strftime("%Y-%m") %>
          <%= f.text_field :budget_amount, value: BrlMoney.format(budgeted), inputmode: "decimal",
                class: "field-input w-24 text-sm inline", data: { budget_edit_target: "input" } %>
        <% end %>
        <% if error %><span class="field-error"><%= error %></span><% end %>
      </div>
    </div>
    <%= render "shared/budget_bar", spent_cents: spent, budgeted_cents: budgeted %>
  </div>
<% end %>

<%# app/views/cards/_form.html.erb — locals: card:, days:, url: %>
<%= form_with model: card, url: url, class: "space-y-4" do |f| %>
  <%= render "shared/errors", model: card %>
  <div>
    <%= f.label :name, "Nome", class: "field-label" %>
    <%= f.text_field :name, class: "field-input" %>
  </div>
  <div class="flex gap-4">
    <div>
      <%= f.label :closing_day, "Dia de fechamento", class: "field-label" %>
      <%= f.number_field :closing_day, value: days[:closing_day], min: 1, max: 31,
            class: "rounded border border-border bg-surface text-text px-3 py-2 text-sm w-24" %>
    </div>
    <div>
      <%= f.label :due_day, "Dia de vencimento", class: "field-label" %>
      <%= f.number_field :due_day, value: days[:due_day], min: 1, max: 31,
            class: "rounded border border-border bg-surface text-text px-3 py-2 text-sm w-24" %>
    </div>
  </div>
  <p class="text-xs text-muted">
    Se o dia de vencimento não for maior que o de fechamento, a fatura vence no
    mês seguinte ao fechamento.
  </p>
  <%= f.submit "Salvar", class: "btn btn-primary" %>
<% end %>

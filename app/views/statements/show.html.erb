<%# app/views/statements/show.html.erb %>
<div class="mb-4">
  <h1 class="text-lg font-semibold"><%= @card.name %> · <%= statement_due_label(@row.statement) %></h1>
  <p class="text-sm text-muted">
    compras de <%= statement_period_label(@row) %> · fecha <%= @row.statement.effective_closing.strftime("%d/%m/%Y") %>
  </p>
  <div class="mt-1 flex items-center gap-3">
    <p class="text-money-expense font-medium"><%= brl(@row.total_cents) %></p>
    <%= render "statements/status", card: @card, statement: @row.statement, amount_cents: @row.total_cents,
          payments: @payments %>
  </div>
</div>
<div data-controller="selection-total">
  <ul class="bg-surface border border-border rounded-[var(--radius-card)] divide-y divide-border">
    <% @row.expenses.each do |expense| %>
      <%= render "expenses/row", expense:, show_delete: false, show_statement: false %>
    <% end %>
  </ul>
  <%= render "shared/selection_bar" %>
</div>
<% if @paid_with.any? %>
  <h2 class="text-sm font-semibold text-muted mt-4 mb-1">pagamentos</h2>
  <ul class="bg-surface border border-border rounded-[var(--radius-card)] divide-y divide-border">
    <% @paid_with.each do |payment| %>
      <li class="p-3 flex items-center justify-between gap-2">
        <div>
          <p class="font-medium"><%= payment.account.name %></p>
          <p class="text-sm text-muted"><%= payment.date.strftime("%d/%m/%Y") %> · <%= brl(payment.amount_cents) %></p>
        </div>
        <%= link_to "editar", edit_statement_payment_path(payment), class: "text-accent text-sm" %>
      </li>
    <% end %>
  </ul>
<% end %>
<p class="mt-3 text-sm"><%= link_to "todas as faturas", card_statements_path(@card), class: "text-accent" %></p>

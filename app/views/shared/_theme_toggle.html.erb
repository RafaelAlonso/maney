<%# app/views/shared/_theme_toggle.html.erb — the light/dark switch. A real
    toggle: sun on the left, moon on the right, a knob that slides to the side
    of the theme on screen. The `theme` controller positions the knob on connect
    (from the effective theme, since device-follow stamps no class) and on flip. %>
<button type="button" data-controller="theme" data-action="theme#toggle"
        data-theme-target="switch" role="switch" aria-label="Alternar tema"
        class="relative inline-flex h-6 w-11 shrink-0 items-center rounded-full border border-border bg-surface cursor-pointer transition-colors">
  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"
       stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"
       class="absolute left-1 h-3.5 w-3.5 text-money-near pointer-events-none">
    <circle cx="12" cy="12" r="4"/>
    <path d="M12 2v2M12 20v2M2 12h2M20 12h2M5 5l1.4 1.4M17.6 17.6L19 19M19 5l-1.4 1.4M6.4 17.6L5 19"/>
  </svg>
  <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"
       class="absolute right-1 h-3.5 w-3.5 text-muted pointer-events-none">
    <path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8z"/>
  </svg>
  <span data-theme-target="knob"
        class="relative z-10 h-5 w-5 rounded-full bg-accent shadow translate-x-0.5 transition-transform"></span>
</button>

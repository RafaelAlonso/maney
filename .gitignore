# See https://help.github.com/articles/ignoring-files for more about ignoring files.
#
# Temporary files generated by your text editor or operating system
# belong in git's global ignore instead:
# `$XDG_CONFIG_HOME/git/ignore` or `~/.config/git/ignore`

# Ignore bundler config.
/.bundle

# Ignore all environment files.
/.env*

# Ignore all logfiles and tempfiles.
/log/*
/tmp/*
!/log/.keep
!/tmp/.keep

# Ignore pidfiles, but keep the directory.
/tmp/pids/*
!/tmp/pids/
!/tmp/pids/.keep

/public/assets

# Ignore key files for decrypting credentials and more.
/config/*.key


# Workspace de PM (visão, requisitos, roadmap, decisões, epics, stories, specs,
# planos). Documenta o projeto, não faz parte do código-fonte.
/project/

/app/assets/builds/*
!/app/assets/builds/.keep

/.worktrees/

# Kamal secrets. Real values, never committed. Kamal reads three shapes:
# `secrets`, `secrets-common` and `secrets.<destination>` — all of them hold a
# RAILS_MASTER_KEY, so all of them stay out of git. Only the example is tracked.
/.kamal/secrets*
!/.kamal/secrets.example

<%# app/views/people/index.html.erb %>
<h1 class="text-lg font-semibold mb-4 text-text">Pessoas</h1>

<h2 class="font-medium mb-2 text-text">Convidar</h2>
<%= form_with url: invitations_path, scope: :invitation, class: "flex gap-2 mb-8" do |f| %>
  <%= f.email_field :email_address, required: true, placeholder: "email@exemplo.com",
        class: "field-input flex-1" %>
  <%= f.submit "Convidar", class: "btn btn-primary" %>
<% end %>

<% if @invitations.any? %>
  <h2 class="font-medium mb-2 text-text">Convites</h2>
  <ul class="space-y-3 mb-8">
    <% @invitations.each do |invitation| %>
      <li class="border border-border bg-surface rounded-[var(--radius-card)] p-3 text-sm">
        <p class="font-medium text-text"><%= invitation.email_address %></p>
        <p class="text-muted text-xs">
          <%= invitation_status(invitation) %> · <%= delivery_status(invitation) %>
        </p>
        <div class="flex gap-2 mt-2">
          <%= button_to "Reenviar", resend_invitation_path(invitation), class: "btn btn-secondary" %>
          <%= button_to "Cancelar", invitation_path(invitation), method: :delete, class: "btn btn-secondary" %>
        </div>
      </li>
    <% end %>
  </ul>
<% end %>

<h2 class="font-medium mb-2 text-text">No grupo</h2>
<ul class="space-y-3">
  <% @people.each do |person| %>
    <li class="border border-border bg-surface rounded-[var(--radius-card)] p-3 text-sm">
      <p class="font-medium text-text"><%= person.email_address %></p>
      <p class="text-muted text-xs"><%= person_status(person) %></p>
      <% if person == Current.user %>
        <p class="text-muted text-xs mt-1">Você é a única pessoa que pode convidar.</p>
      <% elsif !person.deleted? %>
        <%# A deleted person's actions are hidden, not just disabled: "Excluir" on
            one already deleted resets their 30-day erasure clock, and "Revogar"
            on one already deleted leaves them unrestorable until access is
            restored first. Status still shows above; only the buttons go. %>
        <div class="flex gap-2 mt-2">
          <% if person.access_revoked? %>
            <%= button_to "Restaurar acesso", person_access_path(person), class: "btn btn-secondary" %>
          <% else %>
            <%= button_to "Revogar", person_access_path(person), method: :delete, class: "btn btn-secondary" %>
          <% end %>
          <%= button_to "Excluir", person_path(person), method: :delete, class: "btn btn-danger" %>
        </div>
      <% end %>
    </li>
  <% end %>
</ul>

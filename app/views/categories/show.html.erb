<%# app/views/categories/show.html.erb — the two charts sit above the expense
    list, which is the detail behind them and stays exactly as it was.
    It reuses expenses/_row with show_delete: false (the drill-down only offers
    editing) and show_category: false (every row is of this category — the <h1>
    already says which). %>
<h1 class="text-lg font-semibold mb-2"><%= @category.name %></h1>
<%= render "shared/month_nav", path_helper: ->(month:) { category_path(@category, month:) } %>

<%# The month nav has no forward bound, so the user can stand on a month the
    year chart deliberately does not plot — it stops at the current month, while
    the pie and the list below show that month's committed parcels. The note
    says so, rather than leaving the two panels reading as a contradiction. %>
<% covered = @category_year.covers?(current_month) %>
<% if @category_year.any_data? %>
  <%= render "shared/chart", chart: @year_chart %>
<% else %>
  <%= render layout: "shared/card", locals: { title: @year_chart.title } do %>
    <p class="text-sm text-muted">
      <% if @category_year.started? %>
        Nenhum gasto nesta categoria em <%= @category_year.year %>.
      <% else %>
        <%= @category_year.year %> ainda não começou.
      <% end %>
    </p>
  <% end %>
<% end %>

<% unless covered %>
  <p class="text-sm text-muted -mt-2 mb-4">
    O gráfico do ano cobre só os meses já acontecidos; <%= current_month.strftime("%m/%Y") %> aparece apenas na composição abaixo.
  </p>
<% end %>

<%= render "categories/breakdown", chart: @breakdown %>

<ul class="divide-y divide-border rounded border border-border bg-surface">
  <% @expenses.each do |expense| %>
    <%= render "expenses/row", expense:, show_delete: false, show_category: false, statements: @statements %>
  <% end %>
  <% if @expenses.empty? %><%= render "shared/empty_state", message: "Nenhum gasto nesta categoria no mês." %><% end %>
</ul>

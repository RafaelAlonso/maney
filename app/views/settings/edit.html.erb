<%# app/views/settings/edit.html.erb %>
<h1 class="text-lg font-semibold mb-4 text-text">Configurações</h1>

<%= form_with url: settings_path, scope: :setting, method: :patch, class: "space-y-4 mb-8" do |f| %>
  <%= render "shared/errors", model: @setting %>
  <div>
    <%= f.label :first_month, "Primeiro mês", class: "field-label" %>
    <%= f.month_field :first_month, value: @first_month_input, class: "field-input" %>
    <p class="text-xs text-muted mt-1">A linha do tempo começa aqui; não pode passar de um mês que já tem lançamentos.</p>
  </div>
  <div>
    <%= f.label :initial_balance, "Saldo inicial (R$)", class: "field-label" %>
    <%= f.text_field :initial_balance, value: @initial_balance_input,
          inputmode: "decimal", class: "field-input" %>
  </div>
  <div>
    <%= f.label :alert_threshold_percent, "Alerta de fatura (% do saldo)", class: "field-label" %>
    <%= f.number_field :alert_threshold_percent, value: @alert_threshold_input, min: 1, max: 100,
          class: "field-input" %>
    <p class="text-xs text-muted mt-1">Abaixo desse percentual do saldo atual, as faturas do próximo mês não geram alerta amarelo.</p>
  </div>
  <%= f.submit "Salvar", class: "btn btn-primary" %>
<% end %>

<h2 class="font-medium mb-2 text-text">Categorias reservadas</h2>
<p class="text-sm text-muted mb-3">Renomeáveis; não podem ser excluídas.</p>
<div class="space-y-3">
  <% @reserved.each do |category| %>
    <%= form_with model: category, url: category_path(category), class: "flex gap-2" do |f| %>
      <%= f.text_field :name, class: "field-input flex-1" %>
      <%= f.submit "Renomear", class: "btn btn-secondary" %>
    <% end %>
  <% end %>
</div>

<h2 class="font-medium mt-8 mb-2 text-text">Conta</h2>
<div class="space-y-3">
  <% if Current.user.admin? %>
    <p><%= link_to "Pessoas", people_path, class: "text-accent text-sm" %></p>
  <% end %>
  <p><%= link_to "política de privacidade", privacy_path, class: "text-accent text-sm" %></p>
  <%= button_to "sair", session_path, method: :delete, class: "btn btn-secondary" %>
  <% unless Current.user.admin? %>
    <p class="pt-2">
      <%= link_to "excluir minha conta", new_account_deletion_path, class: "text-money-expense text-sm" %>
    </p>
  <% end %>
</div>

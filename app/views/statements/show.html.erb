<%# app/views/statements/show.html.erb %>
<div class="mb-4">
  <h1 class="text-lg font-semibold"><%= @card.name %> · <%= statement_due_label(@row.statement) %></h1>
  <p class="text-sm text-muted">
    compras de <%= statement_period_label(@row) %> · fecha <%= @row.statement.effective_closing.strftime("%d/%m/%Y") %>
  </p>
  <p class="mt-1 text-money-expense font-medium"><%= brl(@row.total_cents) %></p>
</div>
<ul class="bg-surface border border-border rounded-[var(--radius-card)] divide-y divide-border">
  <% @row.expenses.each do |expense| %>
    <%= render "expenses/row", expense:, show_delete: false, show_statement: false %>
  <% end %>
</ul>
<p class="mt-3 text-sm"><%= link_to "todas as faturas", card_statements_path(@card), class: "text-accent" %></p>

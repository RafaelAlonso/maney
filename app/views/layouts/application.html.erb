<!DOCTYPE html>
<html lang="pt-BR">
  <head>
    <title><%= content_for(:title) || "Maney" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="application-name" content="Maney">
    <%# Without this, Add to Home Screen on iOS names the app after <title>, so
        installing from Análise would call it "Análise". Android reads
        short_name from the manifest and needs no equivalent. %>
    <meta name="apple-mobile-web-app-title" content="Maney">
    <meta name="mobile-web-app-capable" content="yes">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= yield :head %>

    <%= tag.link rel: "manifest", href: pwa_manifest_path(format: :json) %>
    <meta name="theme-color" content="#059669">
    <%# Offline, a restored snapshot would present old totals as current — the one
        failure this app cannot afford. Without a snapshot, a back-navigation makes
        a real request, which fails and lands on the no-connection screen. %>
    <meta name="turbo-cache-control" content="no-cache">
    <%# Prefetching keeps a fetched page in memory and hands it to a later visit
        without a request leaving the browser, so neither the service worker nor
        the tag above ever sees it. Offline that means figures up to ten seconds
        old presented as current — the same failure by another route. %>
    <meta name="turbo-prefetch" content="false">

    <link rel="icon" href="/icon.png" type="image/png">
    <link rel="icon" href="/icon.svg" type="image/svg+xml">
    <link rel="apple-touch-icon" href="/apple-touch-icon.png">

    <%= stylesheet_link_tag "tailwind", "data-turbo-track": "reload" %>

    <%# Includes all stylesheet files in app/assets/stylesheets %>
    <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>
    <%# The import map pins scoped package names ("@hotwired/turbo-rails", ...),
        so it puts a literal "@" in every response that includes it. The
        invalid-link screen (SignupsController) must reveal nothing about whose
        invitation it was, so it sets @omit_importmap_tags to keep that "@" out
        of its body — everything else here still applies to it. %>
    <%= javascript_importmap_tags unless @omit_importmap_tags %>
  </head>

  <body class="min-h-screen bg-gray-50 text-gray-900 pb-24">
    <% if authenticated? && Setting.instance %>
      <%# `shrink-0` + `whitespace-nowrap` are what make `overflow-x-auto` work.
          Flex items shrink below their content by default, so on a 360 px phone
          the nav silently squeezed the last items instead of overflowing —
          "Categorias" clipped, "Config" rendered as "Co", and with
          scrollWidth === clientWidth there was no gesture left to reach it.
          Configurações is the only route to the alert threshold, the initial
          balance and the first month, so that made them unreachable. %>
      <nav class="flex gap-4 px-4 py-3 border-b bg-white text-sm overflow-x-auto whitespace-nowrap">
        <%= link_to "Início", root_path, class: "shrink-0" %>
        <%= link_to "Gastos", expenses_path, class: "shrink-0" %>
        <%= link_to "Ganhos", incomes_path, class: "shrink-0" %>
        <%= link_to "Cartões", cards_path, class: "shrink-0" %>
        <%= link_to "Categorias", categories_path, class: "shrink-0" %>
        <%= link_to "Análise", analysis_path, class: "shrink-0" %>
        <%= link_to "Config", edit_settings_path, class: "shrink-0" %>
      </nav>
    <% end %>
    <% if notice %><p class="bg-emerald-50 text-emerald-800 px-4 py-2 text-sm"><%= notice %></p><% end %>
    <% if alert %><p class="bg-red-50 text-red-800 px-4 py-2 text-sm"><%= alert %></p><% end %>
    <main class="p-4 max-w-xl mx-auto"><%= yield %></main>
    <%= render "shared/fab" if authenticated? && Setting.instance %>
  </body>
</html>

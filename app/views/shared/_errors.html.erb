<% if model.errors.any? %>
  <div class="bg-money-expense/10 border border-money-expense/30 text-money-expense rounded p-3 mb-4 text-sm">
    <ul class="list-disc list-inside">
      <% model.errors.full_messages.each do |message| %>
        <li><%= message %></li>
      <% end %>
    </ul>
  </div>
<% end %>

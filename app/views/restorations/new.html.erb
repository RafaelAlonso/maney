<%# app/views/restorations/new.html.erb — the only screen a deleted account reaches. %>
<h1 class="text-lg font-semibold mb-4 text-text">Sua conta está excluída</h1>

<p class="text-sm text-muted mb-4">
  Tudo o que é seu será apagado em definitivo em
  <strong class="text-text"><%= pluralize(Current.user.days_until_erasure, "dia", "dias") %></strong>.
  Até lá, você pode restaurar sua conta exatamente como estava.
</p>

<%= button_to "restaurar minha conta", restoration_path, class: "btn btn-primary" %>

<%= button_to "sair", session_path, method: :delete, class: "btn btn-secondary mt-3" %>

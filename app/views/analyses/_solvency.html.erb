<%# locals: solvency (a Budgeting::Solvency) %>
<section class="card">
  <h2 class="font-medium text-sm mb-3">Dívida já comprometida</h2>

  <% if solvency.any? %>
    <% if solvency.covered? %>
      <p class="font-medium text-money-positive">O saldo cobre a dívida já comprometida.</p>
    <% else %>
      <p class="font-medium text-money-expense">
        Em <%= month_label(solvency.shortfall_row.month, today: solvency.today) %> a dívida passa o saldo.
      </p>
      <p class="text-sm text-money-expense">Faltam <%= brl(solvency.shortfall_cents) %>.</p>
    <% end %>
    <p class="text-sm text-muted mb-3">Saldo hoje <%= brl(solvency.money_on_hand_cents) %></p>

    <table class="w-full text-sm">
      <thead>
        <tr class="text-left text-muted">
          <th class="font-normal py-1">Mês</th>
          <th class="font-normal py-1 text-right">Comprometido</th>
          <th class="font-normal py-1 text-right">Acumulado</th>
        </tr>
      </thead>
      <tbody>
        <% solvency.rows.each do |row| %>
          <tr class="border-t border-border <%= "text-money-expense font-medium" if row == solvency.shortfall_row %>">
            <td class="py-1">
              <%= month_label(row.month, today: solvency.today) %>
              <% if row.month == solvency.current_month && solvency.arrears_cents.positive? %>
                <span class="text-muted">· inclui <%= brl(solvency.arrears_cents) %> em atraso</span>
              <% end %>
            </td>
            <td class="py-1 text-right"><%= brl(row.committed_cents) %></td>
            <td class="py-1 text-right"><%= brl(row.cumulative_cents) %></td>
          </tr>
        <% end %>
      </tbody>
    </table>
  <% else %>
    <p class="text-sm text-muted">Não há dívida comprometida no cartão.</p>
  <% end %>

  <p class="mt-3 text-xs text-muted">
    Não inclui receitas futuras nem gastos comuns futuros.
  </p>
</section>

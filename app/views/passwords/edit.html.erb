<%# app/views/passwords/edit.html.erb %>
<h1 class="text-lg font-semibold mb-4 text-text">Nova senha</h1>

<%= form_with url: password_path(params[:token]), method: :put, scope: :user, class: "space-y-4" do |f| %>
  <div>
    <%= f.label :password, "Senha", class: "field-label" %>
    <%= f.password_field :password, required: true, autocomplete: "new-password",
          maxlength: 72, class: "field-input" %>
  </div>
  <div>
    <%= f.label :password_confirmation, "Repita a senha", class: "field-label" %>
    <%= f.password_field :password_confirmation, required: true, autocomplete: "new-password",
          maxlength: 72, class: "field-input" %>
  </div>
  <%= f.submit "salvar", class: "btn btn-primary" %>
<% end %>

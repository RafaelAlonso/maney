<!DOCTYPE html>
<html lang="pt-BR">
  <head>
    <title><%= content_for(:title) || "Maney" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">

    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <link rel="icon" href="/icon.png" type="image/png">
    <link rel="icon" href="/icon.svg" type="image/svg+xml">
    <link rel="apple-touch-icon" href="/apple-touch-icon.png">

    <%= stylesheet_link_tag "tailwind", "data-turbo-track": "reload" %>
    <%# Includes all stylesheet files in app/assets/stylesheets %>
    <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>

    <%# No javascript_importmap_tags here on purpose: neither the signup form
        nor the invalid-link screen needs Stimulus or Turbo, and the importmap's
        scoped package names ("@hotwired/...") would otherwise put an "@" in
        every response from this controller — including the invalid-link
        screen, which must reveal nothing about whose invitation it was. %>
  </head>

  <body class="min-h-screen bg-gray-50 text-gray-900 pb-24">
    <main class="p-4 max-w-xl mx-auto"><%= yield %></main>
  </body>
</html>

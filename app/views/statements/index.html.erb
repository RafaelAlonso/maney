<%# app/views/statements/index.html.erb %>
<div class="mb-4">
  <h1 class="text-lg font-semibold"><%= @card.name %> · faturas</h1>
  <p class="text-sm text-gray-500"><%= card_days_label(@schedule) %></p>
</div>
<% if @card_statements.empty? %>
  <p class="p-3 text-sm text-gray-500 bg-white rounded border">
    Nenhuma fatura ainda — lance um gasto no crédito neste cartão.
  </p>
<% else %>
  <%= render "statements/block", title: "Em aberto", rows: @card_statements.open, card: @card %>
  <%= render "statements/block", title: "Fechadas", rows: @card_statements.closed, card: @card %>
<% end %>

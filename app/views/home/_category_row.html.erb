<%# app/views/home/_category_row.html.erb — locals: category, summary, percent_mode,
    expenses_total_cents. A two-branch delegator: the reserved credit-card
    category keeps its own disclosure row; every ordinary category is now a single
    link covering the whole card (the drill-down is reached by tapping anywhere on
    it), with its budget shown READ-ONLY. Editing a budget moved to the category's
    own dashboard, so there is no form, no budget-edit controller and no error
    branch here any more. The card keeps id=dom_id(category, :row) so tests and any
    future row-scoped stream can still find it. %>
<% if category.credit_card? %>
  <%= render "home/credit_card_row", category:, summary: %>
<% else %>
  <% spent = summary.spent_cents(category) %>
  <% budgeted = summary.budgeted_cents(category) %>
  <%# An unbudgeted category (budgeted 0) is not an overrun — it's one the user
      hasn't got to yet — so it is not painted red (w3 AC3 highlights THE overrun). %>
  <% over = budgeted.positive? && spent > budgeted %>
  <% earnings_pct = share_percent(spent, summary.incomes_total_cents) %>
  <% expenses_pct = share_percent(spent, expenses_total_cents) %>
  <%= link_to category_path(category, month: summary.month.strftime("%Y-%m")),
        id: dom_id(category, :row),
        class: "block p-4 hover:bg-bg/60 transition-colors" do %>
    <div class="flex items-center justify-between gap-2">
      <span class="text-text font-medium truncate"><%= category.name %></span>
      <%# Each segment is whitespace-nowrap so the line can only ever break at the
          single space between them — never inside an amount. %>
      <div class="text-sm text-right shrink-0">
        <span class="whitespace-nowrap <%= over ? "text-money-over font-medium" : "text-muted" %>">
          gasto <%= brl(spent) %> /
        </span>
        <span class="whitespace-nowrap <%= over ? "text-money-over font-medium" : "text-muted" %>">
          orçado <%= brl(budgeted) %>
        </span>
      </div>
    </div>
    <%# Both readings are rendered; the percent switch above the list shows one and
        hides the other client-side (and the server hides the inactive one up front,
        from the cookie, so there is no flash on load). %>
    <div class="mt-1 text-xs text-muted">
      <span data-percent-target="earnings" class="<%= "hidden" unless percent_mode == "earnings" %>">
        <%= earnings_pct ? "#{earnings_pct}% dos ganhos" : "— dos ganhos" %>
      </span>
      <span data-percent-target="expenses" class="<%= "hidden" unless percent_mode == "expenses" %>">
        <%= expenses_pct ? "#{expenses_pct}% dos gastos" : "— dos gastos" %>
      </span>
    </div>
    <div class="mt-2">
      <%= render "shared/budget_bar", spent_cents: spent, budgeted_cents: budgeted %>
    </div>
  <% end %>
<% end %>

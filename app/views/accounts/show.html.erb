<%# app/views/accounts/show.html.erb %>
<% closing = @balances.closing_cents(@account) %>
<div class="mb-2">
  <h1 class="text-lg font-semibold">
    <%= @account.name %>
    <% if @account.archived? %>
      <span class="ml-2 align-middle text-xs font-normal bg-border text-muted rounded px-2 py-0.5">arquivada</span>
    <% end %>
  </h1>
  <p class="mt-1 font-medium tabular-nums <%= "text-money-over" if closing.negative? %>"><%= brl(closing) %></p>
</div>
<div class="flex gap-4 text-sm mb-4">
  <%= link_to "editar conta", edit_account_path(@account), class: "text-accent" %>
  <% unless @account.reserved? || @account.archived? %>
    <%= button_to "arquivar", account_archival_path(@account), method: :post, class: "text-accent" %>
  <% end %>
</div>
<%= render "shared/month_nav", path_helper: ->(month:) { account_path(@account, month:) } %>
<ul class="bg-surface border border-border rounded-[var(--radius-card)] divide-y divide-border">
  <li class="p-3 flex items-center justify-between bg-bg">
    <span class="font-medium">saldo anterior</span>
    <span class="tabular-nums"><%= brl(@balances.opening_cents(@account)) %></span>
  </li>
  <% @movements.each do |movement| %>
    <li class="p-3 flex items-center justify-between gap-2">
      <div class="min-w-0">
        <p class="font-medium"><%= link_to_if movement_edit_path(movement), movement.name, movement_edit_path(movement), class: "text-accent" %></p>
        <p class="text-sm text-muted"><%= movement.date.strftime("%d/%m") %></p>
      </div>
      <div class="text-right shrink-0 tabular-nums">
        <p class="<%= movement.amount_cents.negative? ? "text-money-expense" : "text-money-positive" %>">
          <%= movement.amount_cents.positive? ? "+" : "" %><%= brl(movement.amount_cents) %>
        </p>
        <p class="text-sm text-muted"><%= brl(movement.balance_after_cents) %></p>
      </div>
    </li>
  <% end %>
  <% if @movements.empty? %><%= render "shared/empty_state", message: "Nenhuma movimentação neste mês." %><% end %>
  <li class="p-3 flex items-center justify-between bg-bg">
    <span class="font-medium">saldo</span>
    <span class="tabular-nums <%= "text-money-over" if closing.negative? %>"><%= brl(closing) %></span>
  </li>
</ul>
<p class="mt-3 text-sm"><%= link_to "todas as contas", accounts_path(month: month_param), class: "text-accent" %></p>

<%# app/views/passwords/new.html.erb %>
<h1 class="text-lg font-semibold mb-4 text-text">Esqueci minha senha</h1>

<%= form_with url: passwords_path, class: "space-y-4" do |f| %>
  <div>
    <%= f.label :email_address, "E-mail", class: "field-label" %>
    <%= f.email_field :email_address, required: true, autofocus: true, autocomplete: "username",
          class: "field-input" %>
  </div>
  <%= f.submit "enviar link", class: "btn btn-primary" %>
<% end %>

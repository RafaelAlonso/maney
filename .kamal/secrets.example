# Copy to .kamal/secrets and fill in. That file is gitignored and must never
# be committed. Nothing here is a real value.

# GitHub classic PAT with write:packages
KAMAL_REGISTRY_PASSWORD=

# Contents of config/master.key
RAILS_MASTER_KEY=

# One generated password, used for both names below
MANEY_DATABASE_PASSWORD=
POSTGRES_PASSWORD=

# R2 API token scoped to the maney-backups bucket, object read/write only
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=

# healthchecks.io ping URL, secret because it is unguessable
HEALTHCHECK_URL=

# Not secrets — the accessory reads these from config/deploy.yml. They live here
# too because bin/restore-drill and the backup smoke tests source this file and
# need them. AGE_RECIPIENT is a public key by construction.
R2_BUCKET=maney-backups
R2_ENDPOINT=
AGE_RECIPIENT=

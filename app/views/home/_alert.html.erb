<%# app/views/home/_alert.html.erb — locals: alert %>
<% case alert.level %>
<% when :red %>
  <div class="mt-4 rounded border border-money-over/30 bg-money-over/10 text-money-over p-3 text-sm">
    As faturas do próximo mês ultrapassam o saldo atual deste mês.
  </div>
<% when :yellow %>
  <div class="mt-4 rounded border border-money-near/30 bg-money-near/10 text-text p-3 text-sm">
    As faturas do próximo mês se aproximam do saldo atual deste mês.
  </div>
<% end %>

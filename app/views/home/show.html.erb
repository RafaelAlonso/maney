<%# app/views/home/show.html.erb %>
<%= render "shared/month_nav", path_helper: ->(month:) { root_path(month:) } %>
<%= render "home/balances", summary: @summary %>
<%= render "home/alert", alert: @alert %>
<div class="bg-white rounded border divide-y mt-4">
  <% @categories.each do |category| %>
    <%= render "home/category_row", category:, summary: @summary %>
  <% end %>
</div>

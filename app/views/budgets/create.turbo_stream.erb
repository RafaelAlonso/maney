<%# app/views/budgets/create.turbo_stream.erb %>
<%= turbo_stream.replace dom_id(@category, :row) do %>
  <%= render "home/category_row", category: @category, summary: @summary, error: @error %>
<% end %>
<% unless @error %>
  <%= turbo_stream.replace "hero" do %>
    <%= render "home/hero", summary: @summary %>
  <% end %>
<% end %>

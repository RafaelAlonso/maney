<%# app/views/categories/show.html.erb — reuses expenses/_row (Task 6),
    show_delete: false: the category drill-down only offers editing.
    show_category: false: every row is already of this category — the <h1> above
    already says which — repeating the name on each row would be just noise. %>
<h1 class="text-lg font-semibold mb-2"><%= @category.name %></h1>
<%= render "shared/month_nav", path_helper: ->(month:) { category_path(@category, month:) } %>
<ul class="divide-y bg-white rounded border">
  <% @expenses.each do |expense| %>
    <%= render "expenses/row", expense:, show_delete: false, show_category: false %>
  <% end %>
  <% if @expenses.empty? %><li class="p-3 text-sm text-gray-500">Nenhum gasto nesta categoria no mês.</li><% end %>
</ul>
